{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ps-locator",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "account_id": "74451318eb3c73358e60351ee92691e5",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "kadeehub.online",
      "custom_domain": true
    },
    {
      "pattern": "www.kadeehub.online",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ps-locator-stats",
      "database_id": "2377b3b0-2ae1-43ae-b025-a4b42a8d1b29"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "ps-locator-gazette"
    }
  ],
  "vars": {
    "AI_DAILY_LIMIT": "250"
  }
}
